# Copy to .env and fill in. .env itself is gitignored - never commit real
# secrets. Generate JWT_SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JSON array, not comma-separated - that's how pydantic-settings parses a
# list[str] field from an env var by default. Empty by default: no real
# frontend exists yet, so there's nothing to trust until one does.
# Example once one exists: CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGINS=[]
